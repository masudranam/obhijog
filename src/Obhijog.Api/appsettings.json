{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "Container": "complaint-attachments",
    "ReadSasMinutes": 15
  },
  "Attachments": {
    "MaxSizeBytes": 5242880,
    "AllowedContentTypes": "image/jpeg,image/png,image/webp",
    "MaxPerComplaint": 5
  },
  "Sla": {
    "SweepIntervalSeconds": 60,
    "WarningThresholdPercent": 80,
    "EscalationLevel2Percent": 150,
    "AutoCloseAfterDays": 7,
    "SweepBatchSize": 200,
    "Transport": "InProcess"
  },
  "ServiceBus": {
    "QueueName": "sla-events"
  },
  "Notifications": {
    "Delivery": "Log"
  }
}
