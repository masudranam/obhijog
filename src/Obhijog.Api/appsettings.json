{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "Container": "complaint-attachments",
    "ReadSasMinutes": 15
  },
  "Attachments": {
    "MaxSizeBytes": 5242880,
    "AllowedContentTypes": "image/jpeg,image/png,image/webp",
    "MaxPerComplaint": 5
  }
}
