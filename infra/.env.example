# Local development configuration. Copy to `.env` in this directory and fill in.
# `.env` is gitignored; this file is committed and must never carry a real value.
# SPEC.md §19 is the authoritative table — this file mirrors it.

# ---- PostgreSQL (infra/docker-compose.yml) -------------------------------------
# Required. Compose refuses to start without it rather than defaulting to something
# guessable. Any value works locally; it never leaves your machine.
POSTGRES_PASSWORD=

# Optional; both default to `obhijog` and match SPEC.md §19.
POSTGRES_USER=obhijog
POSTGRES_DB=obhijog

# ---- API ------------------------------------------------------------------------
# Read by src/Obhijog.Api. The double underscore is .NET's nesting separator, so
# ConnectionStrings__Postgres binds to the ConnectionStrings:Postgres key.
#
# Required from M1 — startup fails loudly without either of these.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=obhijog;Username=obhijog;Password=;SSL Mode=Disable
Storage__ConnectionString=UseDevelopmentStorage=true

# Optional from M1; defaults live in appsettings.json.
Storage__Container=complaint-attachments
Storage__ReadSasMinutes=15

# ---- Not read yet — the milestone that introduces each is named ------------------
# Required from M3. Must be at least 32 bytes or startup fails.
# Jwt__SigningKey=
# Jwt__Issuer=obhijog
# Jwt__Audience=obhijog
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=14

# Required from M2. The seeder throws without it rather than planting a known password.
# SEED_PASSWORD=

# From M5.
# Attachments__MaxSizeBytes=5242880
# Attachments__AllowedContentTypes=image/jpeg,image/png,image/webp
# Attachments__MaxPerComplaint=5

# From M7. SweepIntervalSeconds=0 disables the hosted service.
# Sla__SweepIntervalSeconds=60
# Sla__WarningThresholdPercent=80
# Sla__EscalationLevel2Percent=150
# Sla__AutoCloseAfterDays=7
# Sla__SweepBatchSize=200
# Sla__Transport=InProcess
# Notifications__Delivery=Log

# From M10.
# ServiceBus__ConnectionString=
# ServiceBus__QueueName=sla-events
